# Recommended (free, CORS-friendly in-page submit): https://web3forms.com → create access key
# Add the same variable in Vercel → Project → Settings → Environment Variables
# VITE_WEB3FORMS_ACCESS_KEY=

# If you do not set Web3Forms, the form uses FormSubmit classic POST (opens a new tab; no CORS).
# Optional inbox override for FormSubmit:
# VITE_CONTACT_EMAIL=you@example.com
