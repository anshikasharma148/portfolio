# Best option (free, reliable, send from this page — no new tab): https://web3forms.com
# Create a key, then in Vercel → Settings → Environment Variables add:
# VITE_WEB3FORMS_ACCESS_KEY=
# Redeploy after saving.

# Optional: where mail goes (mailto + Web3Forms). Default matches the site.
# VITE_CONTACT_EMAIL=you@example.com
